{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Claude Code: set only the portable keys in ~/.claude/settings.json and leave the rest alone
# (permissions and auto-mode context are per machine and never go in this repo).
#   statusLine: model | context used | git branch (needs jq)
#   theme:      Omarchy Dracula, only if no theme was chosen yet (dots-theme changes it later)
set -euo pipefail
mkdir -p "$HOME/.claude"
python3 - "$HOME/.claude/settings.json" <<'EOF'
import json, os, sys
p = sys.argv[1]
d = json.load(open(p)) if os.path.exists(p) else {}
d["statusLine"] = {
    "type": "command",
    "command": (
        "input=$(cat); "
        "model=$(echo \"$input\" | jq -r '.model.display_name // \"?\"'); "
        "used_pct=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); "
        "used_tok=$(echo \"$input\" | jq -r '.context_window.total_input_tokens // \"?\"'); "
        "limit=$(echo \"$input\" | jq -r '.context_window.context_window_size // \"?\"'); "
        "branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?'); "
        "ctx_pct=${used_pct:+$(printf '%.0f' \"$used_pct\")%}; ctx_pct=${ctx_pct:-?%}; "
        "echo \"$model | ctx: $ctx_pct ($used_tok / $limit tokens) | branch: $branch\""
    ),
}
if d.get("theme") in (None, "", "auto", "dark"):
    d["theme"] = "custom:omarchy-dracula"
tmp = p + ".tmp"
json.dump(d, open(tmp, "w"), indent=2)
json.load(open(tmp))
os.replace(tmp, p)
print("claude settings: statusLine set, theme =", d["theme"])
EOF
{{- end }}
